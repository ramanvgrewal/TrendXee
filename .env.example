# Local development defaults. Copy to .env; never commit real credentials.
MONGODB_URI=mongodb://localhost:27017/trendzy
DATABASE_URL=jdbc:postgresql://localhost:5432/trendzy
DB_USERNAME=postgres
DB_PASSWORD=postgres
API_PORT=8080
BUSINESS_PORT=8081
FRONTEND_URL=http://localhost:3000
VITE_API_BASE_URL=http://localhost:8080
VITE_BUSINESS_API_BASE_URL=http://localhost:8081
GOOGLE_CLIENT_ID=local-development
GOOGLE_CLIENT_SECRET=local-development
APP_ADMIN_EMAILS=
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
JWT_PRIVATE_KEY_PATH=file:../private.pem
JWT_PUBLIC_KEY_PATH=file:../public.pem
OUTFIT_VISUAL_ENABLED=true
OUTFIT_FEEDBACK_ENABLED=false
OUTFIT_FEEDBACK_SECRET=
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
CONTACT_FROM=hello@trendxee.com
CONTACT_TO=hello@trendxee.com
