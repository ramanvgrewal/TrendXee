# Copy this file to .env and replace every replace-me value.

# Database
MONGODB_URI=mongodb://localhost:27017/trendzy
DATABASE_URL=jdbc:postgresql://localhost:5432/trendzy
DB_USERNAME=postgres
DB_PASSWORD=replace-me

# Application URLs and ports
API_PORT=8080
BUSINESS_PORT=8081
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000
VITE_API_BASE_URL=http://localhost:8080
VITE_BUSINESS_API_BASE_URL=http://localhost:8081

# OAuth credentials
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me

# Authentication and cookies
APP_ADMIN_EMAILS=
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
JWT_PRIVATE_KEY_PATH=file:../private.pem
JWT_PUBLIC_KEY_PATH=file:../public.pem